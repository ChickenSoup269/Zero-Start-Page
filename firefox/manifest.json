{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "2.0.0",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "permissions": ["bookmarks", "scripting", "tabs", "storage", "identity"],
  "icons": {
    "16": "icon/icon_16.ico",
    "48": "icon/icon_48.ico",
    "128": "icon/icon_128.ico"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "icon/icon_16.ico",
      "48": "icon/icon_48.ico",
      "128": "icon/icon_128.ico"
    }
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "startpage@extension",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.spotify.com/*",
        "*://*.zingmp3.vn/*",
        "*://*.soundcloud.com/*",
        "*://music.apple.com/*",
        "*://*.nhaccuatui.com/*",
        "*://*.nct.vn/*"
      ],
      "js": ["content-media.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "host_permissions": [
    "*://*.google.com/*",
    "*://*.youtube.com/*",
    "*://*.spotify.com/*",
    "*://*.zingmp3.vn/*",
    "*://*.soundcloud.com/*",
    "*://music.apple.com/*",
    "*://*.nhaccuatui.com/*",
    "*://*.nct.vn/*",
    "https://*.unsplash.com/*",
    "https://*.open-meteo.com/*",
    "https://*.ytimg.com/*",
    "https://*.scdn.co/*",
    "https://*.rss2json.com/*",
    "https://*.allorigins.win/*",
    "https://*.codetabs.com/*",
    "https://*.googleapis.com/*",
    "https://*.gstatic.com/*",
    "https://*.jsdelivr.net/*",
    "https://*.cloudflare.com/*",
    "https://*.picsum.photos/*",
    "https://*.loremflickr.com/*",
    "https://*.staticflickr.com/*",
    "https://*.quotable.io/*",
    "https://*.adviceslip.com/*",
    "https://*.type.fit/*",
    "https://api.github.com/*",
    "https://*.githubusercontent.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline' https://*.cloudflare.com https://*.googleapis.com; font-src 'self' data: https://*.cloudflare.com https://*.gstatic.com https://*.jsdelivr.net; img-src 'self' blob: data: https:; media-src 'self' blob: https://*.githubusercontent.com; connect-src 'self' https://*.ytimg.com https://*.scdn.co https://*.google.com https://*.unsplash.com https://*.open-meteo.com https://*.rss2json.com https://*.allorigins.win https://*.codetabs.com https://*.googleapis.com https://*.gstatic.com https://*.picsum.photos https://*.loremflickr.com https://*.staticflickr.com https://*.corsproxy.io https://*.quotable.io https://*.adviceslip.com https://*.type.fit https://api.github.com https://*.githubusercontent.com https://*.jsdelivr.net;"
  }
}
